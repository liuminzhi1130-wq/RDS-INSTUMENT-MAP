<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RDS1 控制閥定位系統</title>
    <style>
        :root {
            --primary-color: #005596; 
            --highlight-color: #ff0000;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            background: #f4f4f4;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        .search-container {
            padding: 15px;
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            z-index: 10;
            display: flex;
            gap: 10px;
        }

        input {
            flex-grow: 1;
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 16px;
        }

        .map-wrapper {
            position: relative;
            flex-grow: 1;
            overflow: auto;
            background: #eee;
            display: flex;
            justify-content: center;
        }

        .map-container {
            position: relative;
            display: inline-block;
        }

        #factory-map {
            display: block;
            max-width: none; 
            height: auto;
        }

        .valve-point {
            position: absolute;
            width: 14px;
            height: 14px;
            background: var(--highlight-color);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            cursor: pointer;
            display: none; 
        }

        .valve-point.active {
            display: block;
            box-shadow: 0 0 0 0 rgba(255, 0, 0, 0.7);
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 0 0 0 rgba(255, 0, 0, 0.7); }
            70% { transform: translate(-50%, -50%) scale(1.3); box-shadow: 0 0 0 15px rgba(255, 0, 0, 0); }
            100% { transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 0 0 0 rgba(255, 0, 0, 0); }
        }

        .label {
            position: absolute;
            top: -22px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            white-space: nowrap;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="search-container">
        <input type="text" id="searchInput" placeholder="輸入控制閥編號 (例如: LV-2001)...">
    </div>

    <div class="map-wrapper">
        <div class="map-container" id="mapContainer">
            <img src="RDS1_map.jpg" id="factory-map" alt="RDS1 位置圖">
            <div id="valveLayer"></div>
        </div>
    </div>

    <script>
        // 控制閥資料座標 (可點擊圖片取得座標後回來更新此處)
        const valveData = [
            { id: "LV-2001", x: 85.00, y: 50.00 },
            { id: "PV-2004", x: 25.00, y: 55.00 },
            { id: "TV-2003", x: 45.00, y: 60.00 },
            { id: "FV-2002", x: 70.00, y: 40.00 }
        ];

        const valveLayer = document.getElementById('valveLayer');
        const searchInput = document.getElementById('searchInput');

        function initValves() {
            valveLayer.innerHTML = '';
            valveData.forEach(valve => {
                const div = document.createElement('div');
                div.className = 'valve-point';
                div.id = `valve-${valve.id}`;
                div.style.left = `${valve.x}%`;
                div.style.top = `${valve.y}%`;
                div.innerHTML = `<span class="label">${valve.id}</span>`;
                valveLayer.appendChild(div);
            });
        }

        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toUpperCase().trim();
            document.querySelectorAll('.valve-point').forEach(p => p.classList.remove('active'));
            if (term.length < 2) return;
            const target = valveData.find(v => v.id.includes(term));
            if (target) {
                const element = document.getElementById(`valve-${target.id}`);
                element.classList.add('active');
                element.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
            }
        });

        // 點擊圖片會在地圖上顯示座標百分比，方便你新增點位
        document.getElementById('factory-map').addEventListener('click', function(e) {
            const rect = this.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width * 100).toFixed(2);
            const y = ((e.clientY - rect.top) / rect.height * 100).toFixed(2);
            alert(`取得座標！\n請將此數值加入程式碼：\n{ id: "新閥號", x: ${x}, y: ${y} }`);
            console.log(`{ id: "NEW", x: ${x}, y: ${y} }`);
        });

        window.onload = initValves;
    </script>
</body>
</html>
